{% extends 'base.html.twig' %}

{% block nowo_ui_page_header %}
    {{ include(nowo_ui_partial('page_header'), {
        title: 'OTP FormType demos',
        intro: 'Each example uses a different configuration (length, numeric-only, uppercase, help text).',
    }) }}
{% endblock %}

{% block body %}
    {% embed '@NowoUiKit/demo_platform/_section.html.twig' with {title: 'Examples', kind: 'table', examples: examples} %}
        {% block section_body %}
            <table class="nowo-ui-data-table">
                <thead>
                    <tr><th scope="col">Example</th><th scope="col">Slug</th></tr>
                </thead>
                <tbody>
                    {% for slug, cfg in examples %}
                        <tr>
                            <td>
                                <a class="nowo-ui-link" href="{{ path('app_demo_otp', { slug: slug }) }}">{{ cfg.title }}</a>
                                <div class="nowo-ui-muted nowo-ui-cell--wrap">{{ cfg.help }}</div>
                            </td>
                            <td><span class="nowo-ui-badge nowo-ui-badge--neutral">{{ slug }}</span></td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        {% endblock %}
    {% endembed %}
{% endblock %}
