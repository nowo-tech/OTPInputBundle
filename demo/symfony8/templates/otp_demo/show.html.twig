{% extends 'base.html.twig' %}

{% block nowo_ui_page_header %}
    {{ include(nowo_ui_partial('page_header'), {
        title: demo_title,
        intro: 'Multi-input visual widget, single string value in Symfony form data.',
    }) }}
{% endblock %}

{% block body %}
    {% embed '@NowoUiKit/demo_platform/_section.html.twig' with {title: 'OTP code', kind: 'form', testid: 'demo-case', form: form} %}
        {% block section_body %}
            {{ form_start(form, {attr: {id: 'demo-otp-form', class: 'nowo-ui-form'}}) }}
                {# REQ-TWIG-003: child loop #}
                {% for child in form %}
                    {% if child.vars.name != 'submit' %}
                        {{ form_row(child) }}
                    {% endif %}
                {% endfor %}
            {{ form_end(form, {render_rest: false}) }}
        {% endblock %}
        {% block section_footer %}{{ form_widget(form.submit) }}{% endblock %}
    {% endembed %}
{% endblock %}

{% block nowo_ui_scripts %}
    {{ parent() }}
    <script src="{{ asset('otp-input.js', 'nowo_otp_input') }}"></script>
{% endblock %}
